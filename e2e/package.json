{
  "name": "e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Playwright end-to-end tests against an isolated test database",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "db:prepare": "node scripts/db-prepare.ts",
    "db:studio": "node scripts/db-studio.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
